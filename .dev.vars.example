# Copy to .dev.vars for local Wrangler testing. Never use real production values here.
PUBLIC_LAUNCH_ENABLED=false
LAUNCH_PRIVACY_NOTICE_APPROVED=false
LAUNCH_TERMS_APPROVED=false
COMPANY_LEGAL_NAME=replace-before-launch
COMPANY_ENTITY_TYPE=replace-before-launch
COMPANY_REGISTRATION_DETAILS=replace-before-launch
COMPANY_REGISTERED_ADDRESS=replace-before-launch
COMPANY_STATE=replace-before-launch
SUPPORT_EMAIL=replace-before-launch
PRIVACY_CONTACT_EMAIL=replace-before-launch
GRIEVANCE_CONTACT_NAME=replace-before-launch
GRIEVANCE_EMAIL=replace-before-launch
DATA_PROCESSING_REGION=verify-and-disclose-before-launch
LEAD_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
MARKETPLACE_ENABLED=false
MARKETPLACE_PRIVACY_NOTICE_APPROVED=false
MARKETPLACE_TERMS_APPROVED=false
MARKETPLACE_GLOBAL_REGIONS_REVIEWED=false
AUTH_HMAC_SECRET=replace-with-at-least-32-random-characters
SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_OTP_ENABLED=false
RESEND_API_KEY=replace-before-enabling-email-otp
OTP_FROM_EMAIL=replace-with-verified-sender
AUTH_PHONE_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=replace-before-enabling-phone-otp
TWILIO_AUTH_TOKEN=replace-before-enabling-phone-otp
TWILIO_FROM_NUMBER=replace-with-verified-e164-number
GUIDE_ID_VERIFICATION_ENABLED=false
GUIDE_ID_VERIFICATION_PROVIDER=replace-after-provider-review
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_OWNER_EMAIL=replace-with-owner-controlled-email
